# Copy to .env (ignored), replace placeholders, and keep permissions 0600.
SERVICE_ROLE=web
DATABASE_URL=postgresql://crowdmovie_web:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/crowdmovie
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
PUBLIC_ORIGIN=https://movie.example.com
PORT=3100
HOST=127.0.0.1
LOG_LEVEL=info
MEDIA_DIR=/var/lib/crowdmovie/media
OUTBOX_PATH=/var/lib/crowdmovie/outbox.log
CODEX_HOME=/var/lib/crowdmovie/codex
CODEX_EXECUTABLE_PATH=/opt/crowdmovie/tools/codex-0.153.4/node_modules/.bin/codex
CODEX_WORKSTATION_DIR=/opt/crowdmovie/workstation
CODEX_MODEL=gpt-5.6-sol
CODEX_OUTPUT_RETRIES=2
CODEX_TURN_TIMEOUT_SECONDS=300
QWEN_COPYRIGHT_FALLBACK_BASE_URL=http://192.168.10.30:8000/v1
QWEN_COPYRIGHT_FALLBACK_MODEL=qwen3.8-27b-huihui-abliterated-nvfp4
QWEN_COPYRIGHT_FALLBACK_TIMEOUT_MS=300000
QWEN_MAX_CONCURRENCY=3
H3_BASE_URL=http://127.0.0.1:8191
H3_POLL_INTERVAL_MS=2000
H3_REQUEST_TIMEOUT_MS=30000
H3_WORKFLOW_REPAIR_RETRIES=2
CROWDMOVIE_ASR_PYTHON=/opt/crowdmovie-film-audio/bin/python
CROWDMOVIE_ASR_SCRIPT=/opt/crowdmovie/ops/film-audio-transcribe.py
CROWDMOVIE_TRUSTED_PROXIES=127.0.0.1,::1
